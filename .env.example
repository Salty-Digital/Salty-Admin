# Template only — real values go in .env.local (gitignored) locally, and in
# Vercel → Project Settings → Environment Variables for deployed environments.
# Never commit real values to this file.

# Supabase (mobile project: lzhrntjwnmrpwebmqyha)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Config Status page — shared secret for the read-only `config-status` edge function in the
# mobile Supabase project. Set the SAME value as an Edge Function secret named
# CONFIG_STATUS_SECRET in that project (Dashboard → Edge Functions → Secrets). The function
# returns only which secrets are set (names/booleans), never values — so no powerful Supabase
# management token is needed. Leave unset to disable the mobile-secrets section.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONFIG_STATUS_SECRET=change-me

# Absolute URL of the running admin panel. Used to build invite links in emails,
# so an incorrect value here makes every invite link go to the wrong host.
#   Local (this repo): http://localhost:3001
#   Local (Salty-Admin-Rahul-Repo clone): http://localhost:3000
#   Vercel: https://<your-deployment>.vercel.app  (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Resend — admin invites and the "email users" feature.
# Create a key at https://resend.com and verify a sending domain first.
# EMAIL_FROM's domain must match a domain you've verified in Resend.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Salty Support <support@support.saltydigital.ai>

# Resend webhook signing secret for /api/webhooks/resend (bounce + complaint suppression).
# In Resend → Webhooks, add an endpoint at https://<your-host>/api/webhooks/resend,
# subscribe it to `email.bounced` and `email.complained`, then paste the signing secret
# (starts with whsec_) here. Without it the webhook rejects every request (fails closed).
RESEND_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# v2 database (Pawel's project) — read-only, powers the Beta Signups analytics page only.
# This is a SEPARATE Supabase project from the one above. Grab both from that project's
# Settings → API. Leave unset to hide/disable the page (it shows a "not connected" notice).
V2_SUPABASE_URL=https://your-v2-ref.supabase.co
V2_SUPABASE_SERVICE_KEY=your-v2-service-role-key

# PostHog — read-only, powers the Build Adoption (build-lag) page only.
# Querying needs a PERSONAL API key (ingestion/project keys are write-only), scoped to
# `query:read` (+ `project:read`). Create one at PostHog → Settings → Personal API keys.
# Leave POSTHOG_API_KEY unset to disable the page (it shows a "not connected" notice).
POSTHOG_API_KEY=phx_your-personal-api-key
POSTHOG_PROJECT_ID=project-id-of-your-posthog-project
# POSTHOG_HOST=https://us.posthog.com   # override only for EU/self-hosted PostHog

# Airtable — read-only, powers the Beta Feedback dashboard only.
# A personal access token (starts with `pat`) scoped to data.records:read on the
# "Beta Users Feedback" base. Create one at https://airtable.com/create/tokens.
# Leave AIRTABLE_API_KEY unset to disable the page (it shows a "not connected" notice).
AIRTABLE_API_KEY=pat_your-personal-access-token
AIRTABLE_BETA_FEEDBACK_BASE_ID=feedback-base-id

# HMAC secret for signing marketing unsubscribe URLs. Any long random string works.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
UNSUBSCRIBE_TOKEN_SECRET=change-me
